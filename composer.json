{
    "name": "klxm/fluid",
    "description": "Blöcke mit Feldschema und Bearbeiten direkt auf der Website für REDAXO 6",
    "homepage": "https://github.com/KLXM/fluid",
    "type": "redaxo-addon",
    "license": "MIT",
    "keywords": [
        "redaxo",
        "redaxo-addon",
        "redaxo6",
        "frontend-editing",
        "page-builder",
        "blocks",
        "yform",
        "cms"
    ],
    "authors": [
        {
            "name": "Thomas Skerbis",
            "homepage": "https://github.com/skerbis",
            "role": "Lead"
        },
        {
            "name": "KLXM Crossmedia GmbH",
            "homepage": "https://klxm.de"
        }
    ],
    "support": {
        "issues": "https://github.com/KLXM/fluid/issues",
        "source": "https://github.com/KLXM/fluid"
    },
    "require": {
        "php": "^8.5",
        "redaxo/core": "^6.0@dev",
        "loupe/loupe": "^1.1",
        "klxm/navigation_array": "^1.0@dev",
        "klxm/klxm_meta": "^1.0@dev"
    },
    "require-dev": {
        "redaxo/php-cs-fixer-config": "^3.1"
    },
    "suggest": {
        "yakamara/yform": "Formulare, Datenlisten, Postfach und das Feld „Fluid-Blöcke“ (YForm 6)",
        "klxm/image_editor": "Bilder auf der Website zuschneiden, drehen, Fokuspunkt setzen"
    },
    "autoload": {
        "psr-4": {
            "Klxm\\Fluid\\": "src/",
            "Klxm\\Fluid\\Kit\\Fluid\\": "kits/fluid/src/",
            "Klxm\\Fluid\\Kit\\Native\\": "kits/native/src/"
        }
    },
    "extra": {
        "redaxo": {
            "addon-class": "Klxm\\Fluid\\FluidAddon"
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    }
}
